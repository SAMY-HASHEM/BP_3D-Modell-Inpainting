# Generated 3D models and logs (large files, can be regenerated)
outputs/

# Input pictures from the internet (belong to other artists)
pictures/

# PyCharm personal settings
.idea/

# Python cache
__pycache__/

# TRELLIS.2 source code, cloned by install.sh (a separate Git repository)
/TRELLIS.2/

# Conda (Miniforge + environment) and model weights, installed by install.sh
/conda/
/local_ai_models/
/models
/VoxHammer/

# The picture AI's output while it paints a prompt (web page, edit by hand)
flows/hand/*/prompt.log

# The web page's accounts (flow_page.py --accounts): names and password hashes, made with accounts.py
/accounts.json

# Training data for the rig head (Rig-XL from UniRig, 5 GB+), downloaded by scripts/rigging
/datasets/
